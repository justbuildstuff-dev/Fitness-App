# Claude Code local settings (user-specific, not for version control)
.claude/settings.local.json
.claude/settings.json

# Sensitive configuration files
*.env
.env
.env.local
.env.*.local

# Temporary files
pr_diff.txt
*.diff
*.patch

# Debug and test output files
$VAR
e2e_*.txt
test_*.txt
*_logs.txt
*_results.txt
TEST_UPDATES_REQUIRED.md
QA_*.md

# Backup files
*.backup

# Local Claude settings
**/.claude/settings.local.json

# API keys and secrets
*secret*
*credential*
# Note: google-services.json and firebase_options.dart are intentionally tracked
# Firebase client API keys are designed to be public and protected by Firestore Security Rules

# Security files (Android signing)
key.properties
**/*.keystore
**/*.jks
**/*.pem
**/*.p12
**/*.key

# Private business documents (not for public repo)
Docs/SecurityReports/
Docs/Monetization_Strategy.md
Docs/ProductionReadiness.md
